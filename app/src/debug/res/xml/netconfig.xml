<?xml version="1.0" encoding="utf-8"?>
<network-security-config>
    <!-- Debug only: USB `adb reverse` exposes the local development API as loopback. -->
    <base-config cleartextTrafficPermitted="false">
        <trust-anchors>
            <certificates src="system" />
        </trust-anchors>
    </base-config>
    <domain-config cleartextTrafficPermitted="true">
        <domain includeSubdomains="false">127.0.0.1</domain>
        <domain includeSubdomains="false">localhost</domain>
    </domain-config>
    <!-- The provider serves its mobile electricity portal over HTTP. -->
    <domain-config cleartextTrafficPermitted="true"><domain includeSubdomains="false">bd.bdfairy.cn</domain></domain-config>
</network-security-config>
