<resources>

    <style name="Widget.Changliplanetapp.AppWidget.Container" parent="android:Widget">
        <item name="android:id">@android:id/background</item>
        <item name="android:background">?android:attr/colorBackground</item>
    </style>

    <style name="Widget.Changliplanetapp.AppWidget.InnerView" parent="android:Widget">
        <item name="android:background">?android:attr/colorBackground</item>
        <item name="android:textColor">?android:attr/textColorPrimary</item>
    </style>
    <style name="AppSecondaryBackButton">
        <item name="android:src">@drawable/ic_secondary_back</item>
        <item name="android:background">@drawable/secondary_back_circle</item>
        <item name="android:padding">12dp</item>
        <item name="android:tint">@color/widget_primary</item>
        <item name="android:contentDescription">返回</item>
        <item name="android:clickable">true</item>
        <item name="android:focusable">true</item>
    </style>
</resources>